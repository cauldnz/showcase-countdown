#!/bin/sh /etc/rc.common
# procd service for the showcase MCP server on the GL-MT3000 (OpenWrt).
# Install: copy to /etc/init.d/showcase-server, chmod +x, then
#   /etc/init.d/showcase-server enable && /etc/init.d/showcase-server start
# Config lives in /etc/showcase/server.env (KEY=VALUE lines).

START=95
STOP=10
USE_PROCD=1

BIN=/usr/bin/showcase-server
ENV_FILE=/etc/showcase/server.env

start_service() {
	[ -x "$BIN" ] || { echo "missing $BIN"; return 1; }
	procd_open_instance
	procd_set_param command "$BIN"
	# Broker is local; event, title and organiser secret come from the env file.
	if [ -f "$ENV_FILE" ]; then
		while IFS='=' read -r key value; do
			case "$key" in ''|\#*) continue ;; esac
			value="${value%\"}"; value="${value#\"}"
			procd_set_param env "$key=$value"
		done < "$ENV_FILE"
	fi
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
